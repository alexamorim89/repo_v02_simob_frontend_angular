name: CI
on:
  push:
    branches: [develop, master]
  pull_request:
    branches: [develop, master]

jobs:
  frontend:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: repo_v02_simob_frontend_angular
    steps:
      - uses: actions/checkout@v3
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'
      - name: Instalar dependências
        run: npm ci
      - name: Lint frontend
        run: npm run lint
      - name: Build frontend
        run: npm run build --if-present
      - name: Test frontend
        run: npm test

  backend-analyze:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: repo_v02_simob_backend_java
    steps:
      - uses: actions/checkout@v3
      - name: Configurar JDK
        uses: actions/setup-java@v3
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: maven
      - name: Análise estática (Checkstyle)
        run: ./mvnw checkstyle:check